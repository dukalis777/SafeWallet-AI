{
  "manifest_version": 3,
  "name": "SafeWallet AI",
  "version": "0.4.2",
  "description": "A Web3 security assistant prototype with automatic ERC-20 approval scanning and resilient public RPC fallbacks.",
  "host_permissions": [
    "https://api.gopluslabs.io/*",
    "https://ethereum-rpc.publicnode.com/*",
    "https://mainnet.base.org/*",
    "https://base-rpc.publicnode.com/*",
    "https://bsc-dataseed.bnbchain.org/*",
    "https://bsc-rpc.publicnode.com/*",
    "https://eth.llamarpc.com/*",
    "https://eth.drpc.org/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "SafeWallet AI"
  }
}
{
  "manifest_version": 3,
  "name": "SafeWallet AI",
  "version": "0.4.6",
  "description": "A Web3 security assistant prototype with Etherscan-indexed automatic ERC-20 approval scanning.",
  "host_permissions": [
    "https://api.gopluslabs.io/*",
    "https://ethereum-rpc.publicnode.com/*",
    "https://mainnet.base.org/*",
    "https://base-rpc.publicnode.com/*",
    "https://bsc-dataseed.bnbchain.org/*",
    "https://bsc-rpc.publicnode.com/*",
    "https://eth.llamarpc.com/*",
    "https://eth.drpc.org/*",
    "https://api.etherscan.io/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "SafeWallet AI"
  },
  "permissions": [
    "storage"
  ]
}